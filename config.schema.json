{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iocalebs/patrolbot/internal/config/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "properties": {
        "wiki": {
          "type": "string"
        },
        "wikis": {
          "additionalProperties": {
            "$ref": "#/$defs/Wiki"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "wiki",
        "wikis"
      ]
    },
    "Wiki": {
      "properties": {
        "apiUrl": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "apiUrl",
        "username",
        "password"
      ]
    }
  }
}
