# For more information on how PatrolBot sources config, refer to "patrolbot config --help"
discord:
  api: https://discord.com/api/v10
  appID: "{{ .Discord.AppID }}"
  publicKey: "{{ .Discord.PublicKey }}"
  token: "{{ .Discord.Token }}"
log:
  level: INFO
userAgent: "PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)"
wiki: "{{ .WikiName }}"
wikis:
  {{ .WikiName }}:
    site:
      url: "{{ .Wiki.Site.URL }}"
      scriptPath: "{{ .Wiki.Site.ScriptPath }}"
      articlePath: "{{ .Wiki.Site.ArticlePath }}"
      rcLinkLimit: 500
      rcMaxAgeDays: 30
    auth:
      username: "{{ .Wiki.Auth.Username }}"
      password: "{{ .Wiki.Auth.Password }}"
    client:
      from: "{{ .Wiki.Client.From }}"
      timeout: "10s"
    reports:
      templateDir: "./templates"
      discordServerID: "{{ .DiscordServerID }}"
      types:
        expiring:
          template: "expiring.tmpl"
          discordChannelID: "{{ .DiscordChannelID }}"
          description: "Counts the number of edits expiring in the next few weeks"
          data:
            patrolExpiring:
              windows:
                - days: 7
                - days: 14
                - days: 30
