env PATROLBOT_WIKIS_ZWEN_SITE_URL=$MOCK_SERVER_URL
mock action=query.*meta=tokens 200 tokens.mock.json
mock action=login 200 login.mock.json

# Scenario: RecentChanges query fails with MediaWiki API error
mock action=query.*list=recentchanges 200 recent-changes-err.mock.json
exec patrolbot report weekly
cmp stdout stdout-mediawiki-error.golden

# Scenario: Recent changes query succeeds
env MOCK_TIME=2026-01-31T00:00:00Z
mock action=query.*list=recentchanges 200 recent-changes.mock.json
exec patrolbot report weekly
scrub stdout stdout-scrubbed
cmp stdout-scrubbed stdout-success.golden
env MOCK_TIME=

-- config.yaml --
userAgent: PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)
wiki: zwen
wikis:
  zwen:
    site:
      url: ""
      scriptPath: /w
      articlePath: /wiki
      rcLinkLimit: 1000
      rcMaxAgeDays: 30
    auth:
      username: username
      password: password
    client:
      from: phantomcalebs@gmail.com
      timeout: 10s
    reports:
      templateDir: ./templates
      types:
        weekly:
          template: weekly.tmpl
          data:
            patrolExpiring:
              windows:
                - hours: 1
                - hours: 24
                - days: 1
                - days: 7
                - weeks: 1
                - weeks: 2
-- templates/weekly.tmpl --
## Weekly patrol report
{{- if .Error }}
Error:
```
{{ .Error }}
```
{{- else }}
Unpatrolled edits are expiring soon:
{{- range .PatrolExpiring.Windows }}
- {{ .Count }} in the next 
    {{- if false }}
    {{- else if gt .Duration.Weeks 1 }} {{ .Duration.Weeks }} weeks
    {{- else if eq .Duration.Weeks 1 }} week
    {{- else if gt .Duration.Days 1 }} {{ .Duration.Days }} days
    {{- else if eq .Duration.Days 1 }} day
    {{- else if gt .Duration.Hours 1 }} {{ .Duration.Hours }} hours
    {{- else if eq .Duration.Hours 1 }} hour
    {{- else }} {{ printf "%+v" .Duration }}
    {{- end }}
{{- end }}
Link to patrol backlog: <{{ .Config.Site.URL }}{{ .Config.Site.ArticlePath }}/Special:RecentChanges?reviewStatus=unpatrolled&limit={{ .Config.Site.RCLinkLimit }}&days={{ .Config.Site.RCMaxAgeDays }}&urlversion=2>
{{ end }}
