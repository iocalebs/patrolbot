env MOCK_TIME=2026-01-31T00:00:00Z
env PORT=8082
env PATROLBOT_SERVER_PORT=$PORT
env PATROLBOT_DISCORD_API=http://$STUB_ADDR
env PATROLBOT_DISCORD_PUBLICKEY=$PUBLIC_KEY
env PATROLBOT_WIKIS_ZWEN_SITE_URL=http://$STUB_ADDR
exec patrolbot serve &
sleep 500ms

# No signature headers
exec curl -i -X POST http://localhost:$PORT/interactions --data-binary @ping.json
scrub stdout
cmp stdout unauthorized.golden

# Invalid signature headers
exec curl -i -X POST http://localhost:$PORT/interactions --data-binary @ping.json --header X-Signature-Ed25519:foo --header X-Signature-Timestamp:bar
scrub stdout
cmp stdout unauthorized.golden

# Valid ping request
sign ping.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @ping.json
scrub stdout
cmp stdout pong.golden

# Invalid request body
sign invalid-body.txt headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @invalid-body.txt
scrub stdout
cmp stdout bad-request.golden

# Invalid interaction type
sign invalid-interaction-type.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @invalid-interaction-type.json
scrub stdout
cmp stdout unsupported-interaction.golden

# Invalid command
sign invalid-command.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @invalid-command.json
scrub stdout
cmp stdout unsupported-command.golden

# Invalid guild_id
sign invalid-guild-id.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @invalid-guild-id.json
scrub stdout
cmp stdout guild-not-configured.golden

# Invalid config for wiki corresponding to guild_id
sign invalid-config.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @invalid-config.json
scrub stdout
cmp stdout invalid-config.golden

# Missing /report option
sign report-no-option.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @report-no-option.json
scrub stdout
cmp stdout no-report-type.golden

# Invalid /report option
sign invalid-option.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @invalid-option.json
scrub stdout
cmp stdout invalid-report-type.golden

# /report command succeeds
stub GET /w/api.php.*meta=tokens 200 stub-mwtokens.json req-mwtokens.http
stub POST /w/api.php.*action=login 200 stub-mwlogin.json req-mwlogin.http
stub GET /w/api.php.*list=recentchanges 200 stub-recentchanges.json req-recentchanges.http
sign report.json headers.txt
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @report.json
scrub stdout
cmp stdout report-success.golden
cmp req-mwtokens.http req-mwtokens.golden.http
cmp req-mwlogin.http req-mwlogin.golden.http
cmp req-recentchanges.http req-recentchanges.golden.http

# /report command fails due to MediaWiki API error
stub GET /w/api.php.*list=recentchanges 502
exec curl -i -X POST http://localhost:$PORT/interactions --header @headers.txt --data-binary @report.json
scrub stdout
cmp stdout report-mediawiki-502-error.golden

-- config.yaml --
discord:
  publicKey: ""
log:
  level: DEBUG
server:
  port: 0
  timeouts:
    readTimeout: 15s
    readHeaderTimeout: 5s
    writeTimeout: 15s
    idleTimeout: 60s
wikis:
  invalidwiki:
    reports:
      discordServerID: invalidWikiServerID
  invalidwiki2:
    site:
      url: ""
    reports:
      discordServerID: ""
  zwen:
    site:
      url: ""
      scriptPath: /w
      articlePath: /wiki
      rcLinkLimit: 1000
      rcMaxAgeDays: 30
    auth:
      username: username
      password: password
    client:
      from: phantomcalebs@gmail.com
      timeout: 10s
    reports:
      templateDir: ./templates
      discordServerID: server123
      types:
        expiring:
          template: expiring.tmpl
          discordChannelID: channel456
          data:
            patrolExpiring:
              windows:
                - days: 7
                - days: 14
                - days: 30
-- templates/expiring.tmpl --
{{ if .Error }}
```
{{ .Error }}
```
{{- else }}
Unpatrolled edits expiring soon:
{{- range .PatrolExpiring.Windows }}
- {{ .Count }} in the next {{ .Duration.Days }} days
{{- end }}
Link to patrol backlog: <{{ .Config.Site.URL }}{{ .Config.Site.ArticlePath }}/Special:RecentChanges?reviewStatus=unpatrolled&limit={{ .Config.Site.RCLinkLimit }}&days={{ .Config.Site.RCMaxAgeDays }}&urlversion=2>
{{ end }}


