sign ping.json SIGNATURE TIMESTAMP PATROLBOT_DISCORD_PUBLICKEY

env PORT=8082
env PATROLBOT_SERVER_PORT=$PORT
exec patrolbot serve &
sleep 500ms

# No signature headers
exec curl -i -X POST http://localhost:$PORT/interactions --data-binary @ping.json
scrub stdout
cmp stdout unauthorized.golden

# Invalid signature headers
exec curl -i -X POST http://localhost:$PORT/interactions --data-binary @ping.json --header X-Signature-Ed25519:foo --header X-Signature-Timestamp:bar
scrub stdout
cmp stdout unauthorized.golden

# Valid ping request
exec curl -i -X POST http://localhost:$PORT/interactions --data-binary @ping.json --header X-Signature-Ed25519:$SIGNATURE --header X-Signature-Timestamp:$TIMESTAMP
scrub stdout
cmp stdout pong.golden

-- config.yaml --
discord:
  publicKey: ""
server:
  port: 0
  timeouts:
    readTimeout: 15s
    readHeaderTimeout: 5s
    writeTimeout: 15s
    idleTimeout: 60s

-- ping.json --
{ "type": 1 }

-- unauthorized.golden --
HTTP/1.1 401 Unauthorized
Date: Thu, 01 Jan 1970 00:00:00 GMT
Content-Length: 0

-- pong.golden --
HTTP/1.1 200 OK
Content-Type: application/json
Date: Thu, 01 Jan 1970 00:00:00 GMT
Content-Length: 11

{"type":1}
