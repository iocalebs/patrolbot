exec patrolbot report --list
cmp stdout stdout.golden

-- stdout.golden --
monthly
weekly
-- config.yaml --
userAgent: "PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)"
wiki: "zwen"
wikis:
  zwen:
    site:
      url: https://zeldawiki.wiki
      scriptPath: /w
      articlePath: /wiki
      rcLinkLimit: 1000
      rcMaxAgeDays: 90
    auth:
      username: PhantomCaleb@PatrolBot
      password: "password"
    client:
      from: phantomcalebs@gmail.com
      timeout: 10s
    reports:
      templateDir: ./templates
      types:
        weekly:
          template: weekly.tmpl
        monthly:
          template: monthly.tmpl
