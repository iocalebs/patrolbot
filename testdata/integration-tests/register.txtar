Host: $STUB_ADDR
Accept-Encoding: gzip
Authorization: Bot token123
Content-Length: 245
Content-Type: application/json
User-Agent: PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)

{
  "description": "Generate a report using data from the MediaWiki API",
  "name": "report",
  "options": [
    {
      "choices": null,
      "description": "Compte le nombre de modifications expirant dans les prochaines semaines",
      "name": "expire",
      "required": false,
      "type": 1
    }
  ]
}
-- stderr-success.golden --
time=1970-01-01T00:00:00Z level=INFO msg="registered /report command" wiki=zwen guildID=123zwen options=expiring
time=1970-01-01T00:00:00Z level=INFO msg="registered /report command" wiki=zwfr guildID=456zwfr options=expire
-- stderr-fail.golden --
time=1970-01-01T00:00:00Z level=ERROR msg="error registering /report command" wiki=zwen guildID=123zwen err="400 Bad Request" body="{}\n"
time=1970-01-01T00:00:00Z level=ERROR msg="error registering /report command" wiki=zwfr guildID=456zwfr err="400 Bad Request" body="{}\n"

   ERROR

  Failed to register one or more Discord commands.

