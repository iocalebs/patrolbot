[short] skip
# Scenario: Home config already exists, user confirms overwrite
env HOME=$WORK/home
mkdir -p $HOME/.patrolbot
cp config.yaml $HOME/.patrolbot/config.yaml
mkdir -p $HOME/.patrolbot/templates
cp weekly.tmpl $HOME/.patrolbot/templates/weekly.tmpl
cp custom.tmpl $HOME/.patrolbot/templates/custom.tmpl

exec vhs cassette.tape
scrub output.ascii
cmp $HOME/.patrolbot/config.yaml new-config.golden.yaml
cmp output.ascii output.golden
cmp $HOME/.patrolbot/templates/weekly.tmpl weekly.golden.tmpl
cmp $HOME/.patrolbot/templates/custom.tmpl custom.tmpl

-- config.yaml --
wiki: zwen

-- weekly.tmpl --
Pre-existing template

-- custom.tmpl --
Pre-existing template

-- cassette.tape --
Output output.ascii
Set Width 3000 # Prevents line wrapping so scrub command can work properly
Set Height 1000 # Prevents navigation text and error messages from being truncated

# Run command, accept overwrite with "y" shortcut
Hide
Sleep 100ms
Type "patrolbot init"
Enter
Sleep 100ms
Show
Hide
Type "y"
Show
Hide

# Attempt to submit empty URL, then fill out properly
Enter
Show
Hide
Type "https://zeldawiki.wiki"
Enter
Show
Hide

# Attempt to submit empty wiki name, then fill out properly
Enter
Show
Hide
Type "zw"
Enter
Show

# Use default script path and article path
Enter
Enter

# Bot username and password
Hide
Type "PhantomCaleb@Patrolbot"
Enter
Show
Hide
Type "password"
Enter
Show

# Contact email
Type "phantomcalebs@example.test"
Enter

# Discord bot config
Type "appID"
Enter
Type "public key"
Enter
Type "token"
Enter

# Discord server and channel ID
Type "server1234"
Enter
Type "channel1234"
Enter

-- weekly.golden.tmpl --
## Weekly patrol report
Unpatrolled edits are expiring soon:
{{- range .PatrolExpiring.Windows }}
- {{ .Count }} in the next 
    {{- if false }}
    {{- else if gt .Duration.Weeks 1 }} {{ .Duration.Weeks }} weeks
    {{- else if eq .Duration.Weeks 1 }} week
    {{- else if gt .Duration.Days 1 }} {{ .Duration.Days }} days
    {{- else if eq .Duration.Days 1 }} day
    {{- else if gt .Duration.Hours 1 }} {{ .Duration.Hours }} hours
    {{- else if eq .Duration.Hours 1 }} hour
    {{- else }} {{ printf "%+v" .Duration }}
    {{- end }}
{{- end }}
Link to patrol backlog: <{{ .Config.Site.URL }}{{ .Config.Site.ArticlePath }}/Special:RecentChanges?reviewStatus=unpatrolled&limit={{ .Config.Site.RCLinkLimit }}&days={{ .Config.Site.RCMaxAgeDays }}&urlversion=2>
-- new-config.golden.yaml --
# For more information on how PatrolBot sources config, refer to "patrolbot config --help"
discord:
  api: https://discord.com/api/v10
  appID: "appID"
  publicKey: "public key"
  token: "token"
log:
  level: INFO
userAgent: "PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)"
wiki: "zw"
wikis:
  zw:
    site:
      url: "https://zeldawiki.wiki"
      scriptPath: "/w"
      articlePath: "/wiki"
      rcLinkLimit: 500
      rcMaxAgeDays: 30
    auth:
      username: "PhantomCaleb@Patrolbot"
      password: "password"
    client:
      from: "phantomcalebs@example.test"
      timeout: "10s"
    reports:
      templateDir: ./templates
      discordServerID: "server1234"
      types:
        weekly:
          template: weekly.tmpl
          discordChannelID: "channel1234"
          data:
            patrolExpiring:
              windows:
                - days: 7
                - days: 14
                - days: 30
-- output.golden --

