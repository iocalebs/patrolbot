env PATROLBOT_WIKIS_ZWEN_SITE_URL=http://$STUB_ADDR
# The patrol command formats revision timestamps in the local timezone, so we set
# TZ to make output stable across developer environments.
env TZ=GMT

exec patrolbot patrol --help
cmp stdout help.golden

exec patrolbot patrol -h
cmp stdout help.golden

# Scenario: user quits after reviewing one edit
stub GET /w/api.php.*meta=tokens.*type=login 200 stub-login-token.json req-mwtokens-login.http
stub POST /w/api.php.*action=login 200 stub-mwlogin.json req-mwlogin.http
stub GET /w/api.php.*meta=tokens.*type=patrol 200 stub-patrol-token.json req-mwtokens-patrol.http
stub GET /w/api.php.*list=recentchanges 200 stub-recentchanges.json req-recentchanges-quit.http
stub GET /w/api.php.*action=compare 200 stub-compare.json req-compare-quit.http
ttyin -stdin quit-prompt
exec patrolbot patrol
scrub stdout
cmp stdout stdout-quit.golden
cmp req-mwtokens-login.http req-mwtokens-login.golden.http
cmp req-mwlogin.http req-mwlogin.golden.http
cmp req-mwtokens-patrol.http req-mwtokens-patrol.golden.http
cmp req-recentchanges-quit.http req-recentchanges.golden.http
cmp req-compare-quit.http req-compare.golden.http

# Scenario: flags influence the recentchanges query
stub GET /w/api.php.*meta=tokens.*type=login 200 stub-login-token.json
stub POST /w/api.php.*action=login 200 stub-mwlogin.json
stub GET /w/api.php.*meta=tokens.*type=patrol 200 stub-patrol-token.json
stub GET /w/api.php.*list=recentchanges 200 stub-recentchanges.json req-recentchanges-flags.http
stub GET /w/api.php.*action=compare 200 stub-compare.json
ttyin -stdin quit-prompt
exec patrolbot patrol --latest --namespace 4 --user ExampleUser
cmp req-recentchanges-flags.http req-recentchanges-flags.golden.http

# Scenario: user marks the edit as patrolled
stub GET /w/api.php.*meta=tokens.*type=login 200 stub-login-token.json req-mwtokens-login-success.http
stub POST /w/api.php.*action=login 200 stub-mwlogin.json req-mwlogin-success.http
stub GET /w/api.php.*meta=tokens.*type=patrol 200 stub-patrol-token.json req-mwtokens-patrol-success.http
stub GET /w/api.php.*list=recentchanges 200 stub-recentchanges.json req-recentchanges-success.http
stub GET /w/api.php.*action=compare 200 stub-compare.json req-compare-success.http
stub POST /w/api.php.*action=patrol 200 stub-patrol.json req-patrol.http
ttyin -stdin accept-prompt
exec patrolbot patrol
scrub stdout
cmp stdout stdout-success.golden
cmp req-mwtokens-login-success.http req-mwtokens-login.golden.http
cmp req-mwlogin-success.http req-mwlogin.golden.http
cmp req-mwtokens-patrol-success.http req-mwtokens-patrol.golden.http
cmp req-recentchanges-success.http req-recentchanges.golden.http
cmp req-compare-success.http req-compare.golden.http
cmp req-patrol.http req-patrol.golden.http

-- accept-prompt --
y

-- decline-prompt --
n

-- quit-prompt --
q

-- config.yaml --
userAgent: PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)
wiki: zwen
wikis:
  zwen:
    site:
      url: ""
      scriptPath: /w
      articlePath: /wiki
    auth:
      username: username
      password: password
    client:
      from: phantomcalebs@gmail.com
      timeout: 10s

-- help.golden --

  Iterate over unpatrolled revisions in Special:RecentChanges confirm whether to mark them as patrolled.                
         
  USAGE  
         
    patrolbot patrol [--flags]  
         
  FLAGS  
         
    -c --config  Path to config file (default locations: ./config.yaml, $HOME/.patrolbot/config.yaml)
    -h --help    Help for patrol
    --latest     Patrol newest revisions first (default: oldest first)
    --namespace  Namespace to patrol (default: all namespaces)
    -u --user    User to patrol (default: all users)
    -w --wiki    Target wiki

-- stdout-quit.golden --

>>> Main Page <<<
Edit
User:ExampleUser
Thu, 01 Jan 1970 00:00:00 GMT
Comment: Fixed typo

@@ -1 +1 @@
-old line
+new line


Mark as patrolled? ([y]es, [N]o, [o]pen in browser, [q]uit):
-- stdout-success.golden --

>>> Main Page <<<
Edit
User:ExampleUser
Thu, 01 Jan 1970 00:00:00 GMT
Comment: Fixed typo

@@ -1 +1 @@
-old line
+new line


Mark as patrolled? ([y]es, [N]o, [o]pen in browser, [q]uit): Revision 42 by ExampleUser marked as patrolled.
