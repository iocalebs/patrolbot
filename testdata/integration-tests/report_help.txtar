exec patrolbot report --help
cmp stdout stdout.golden

-- stdout.golden --

  Generate a report using data from MediaWiki Action API queries.                                                       
         
  USAGE  
         
    patrolbot report <type> [--flags]  
         
  FLAGS  
         
    -c --config  Path to config file (default locations: ./config.yaml, $HOME/.patrolbot/config.yaml)
    -h --help    Help for report
    --list       List available report types
    -w --wiki    Target wiki
    -y --yes     Automatically answer "yes" to any prompts

