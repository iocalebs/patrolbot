exec patrolbot
cmp stdout help.golden

exec patrolbot --help
cmp stdout help.golden

exec patrolbot -h
cmp stdout help.golden

-- help.golden --

  PatrolBot assists with patrolling MediaWiki sites.                                                                    
         
  USAGE  
         
    patrolbot [command] [--flags]  
            
  COMMANDS  
            
    config [command]         Manage PatrolBot configuration
    init                     Initialize PatrolBot configuration
    register [--flags]       Register Discord bot commands
    report <type> [--flags]  Generate a report
    serve [--flags]          Start a Discord webhook server
         
  FLAGS  
         
    -h --help                Help for patrolbot
    -v --version             Version for patrolbot

