[short] skip
# Scenario: No existing home config
# User inputs empty values for scriptPath and articlePath, which would be the case for wikis that configure everything
# To be under the root path
env HOME=$WORK/home
mkdir -p $HOME/.patrolbot
exec vhs cassette.tape
scrub output.ascii
cmp $HOME/.patrolbot/config.yaml new-config.golden.yaml
cmp output.ascii output.golden

-- cassette.tape --
Output output.ascii
Set Width 3000 # prevents text wrapping, which prevents the scrub command from doing its text replacements
Set Height 1000 # prevents navigation text and error messages from being truncated

# Run command
Hide
Type "patrolbot config init"
Enter
Sleep 100ms
Show

# Input URL and wiki name
Type "https://zeldawiki.wiki"
Enter
Type "zw"
Enter

# Erase default script path and article path, submit as empty
Backspace 2 # /w
Enter
Backspace 5 # /wiki
Enter

# Bot username and password
Type "PhantomCaleb@Patrolbot"
Enter
Type "password"
Enter

-- new-config.golden.yaml --
# For more information on how PatrolBot sources config, refer to "patrolbot config --help"
wiki: zw
wikis:
  zw:
    site:
      url: "https://zeldawiki.wiki"
      scriptPath: ""
      articlePath: ""
    auth:
      username: "PhantomCaleb@Patrolbot"
      password: "password"
    client:
      userAgent: "PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)"

-- output.golden --

> patrolbot config init
┃ Wiki URL
┃ > https://en.wikipedia.org

  Wiki name
  A short, one-word ID for use in commands.
  >

  Script path
  You can confirm the wiki's script path by adding {{SCRIPTPATH}} to a sandbox page.
  > /w

  Article path
  You can confirm the wiki's article path by adding {{ARTICLEPATH}} to a sandbox page. Omit the /$1 at the end.
  > /wiki

enter next

















