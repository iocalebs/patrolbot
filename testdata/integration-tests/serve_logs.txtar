[short] skip

# Defaults to info-level logging
! exec patrolbot serve --config config-default-log.yaml &
sleep 500ms
kill
wait
scrub stderr stderr-scrubbed
cmp stderr-scrubbed stderr-info-log.golden

# Log level can be overridden via env variable
env PATROLBOT_LOG_LEVEL=ERROR
sleep 500ms
kill
wait
scrub stderr stderr-scrubbed
! grep ".+" stderr-scrubbed

-- config-default-log.yaml --
server:
  port: 8080
  timeouts:
    readHeaderTimeout: 5s

-- config-with-log.yaml --
log:
  level: INFO
server:
  port: 8080
  timeouts:
    readHeaderTimeout: 5s

-- stderr-info-log.golden --
{"time":"1970-01-01T00:00:00Z","severity":"INFO","logging.googleapis.com/sourceLocation":{"function":"github.com/iocalebs/patrolbot/internal/server.(*Server).Start","file":"/Users/c/src/iocalebs/patrolbot/internal/server/server.go","line":44},"message":"Starting HTTP server","addr":":8080"}
