[short] skip

# Defaults to info-level logging
exec patrolbot serve --config config-default-log.yaml &
sleep 500ms
kill -INT
wait
scrub stderr
cmp stderr stderr-info-log.golden

# Log level can be overridden via env variable
env PATROLBOT_LOG_LEVEL=ERROR
exec patrolbot serve --config config-with-log.yaml &
sleep 500ms
kill -INT
wait
scrub stderr
cmp stderr stderr-error-log.golden

-- config-default-log.yaml --
discord:
  publicKey: 62ba213b620e0fdd7ee296059267ef48b5ebec3e852915fb14f9f390609ffe72
server:
  port: 8081
  timeouts:
    readHeaderTimeout: 5s

-- config-with-log.yaml --
discord:
  publicKey: 62ba213b620e0fdd7ee296059267ef48b5ebec3e852915fb14f9f390609ffe72
log:
  level: INFO
server:
  port: 8081
  timeouts:
    readHeaderTimeout: 5s

-- stderr-info-log.golden --
{"time":"1970-01-01T00:00:00Z","severity":"INFO","logging.googleapis.com/sourceLocation":{"function":"github.com/iocalebs/patrolbot/internal/server.(*Server).Start","file":"github.com/iocalebs/patrolbot/internal/server/server.go","line":58},"message":"Starting HTTP server","addr":":8081"}
{"time":"1970-01-01T00:00:00Z","severity":"INFO","logging.googleapis.com/sourceLocation":{"function":"github.com/iocalebs/patrolbot/internal/server.(*Server).Start","file":"github.com/iocalebs/patrolbot/internal/server/server.go","line":75},"message":"Initiating graceful shutdown"}
{"time":"1970-01-01T00:00:00Z","severity":"INFO","logging.googleapis.com/sourceLocation":{"function":"github.com/iocalebs/patrolbot/internal/server.(*Server).Start","file":"github.com/iocalebs/patrolbot/internal/server/server.go","line":83},"message":"Graceful shutdown completed"}
-- stderr-error-log.golden --

