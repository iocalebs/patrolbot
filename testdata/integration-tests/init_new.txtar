[short] skip
# Scenario: No existing home config
# User inputs empty values for scriptPath and articlePath, which would be the case for wikis that configure everything
# To be under the root path
env HOME=$WORK/home
exec vhs cassette.tape
scrub output.ascii
cmp $HOME/.patrolbot/config.yaml new-config.golden.yaml
cmp output.ascii output.golden

exec ls $HOME/.patrolbot
cmp stdout config-dir.golden

exec ls $HOME/.patrolbot/templates
cmp stdout templates-subdir.golden

-- cassette.tape --
Output output.ascii
Set Width 3000 # Prevents line wrapping so scrub command can work properly
Set Height 1000 # Prevents navigation text and error messages from being truncated

# Run command
Hide
Sleep 100ms
Type "patrolbot init"
Enter
Sleep 100ms
Show

# Input URL and wiki name
Type "https://zeldawiki.wiki"
Enter
Type "zw"
Enter

# Erase default script path and article path, submit as empty
Backspace 2 # /w
Enter
Backspace 5 # /wiki
Enter

# Bot username and password
Type "PhantomCaleb@Patrolbot"
Enter
Type "password"
Enter

# Contact email
Type "phantomcalebs@example.test"
Enter

# Bot token
Type "token"
Enter

# Discord server and channel ID
Type "server1234"
Enter
Type "channel1234"
Enter

-- config-dir.golden --
config.yaml
templates
-- templates-subdir.golden --
weekly.tmpl
-- new-config.golden.yaml --
# For more information on how PatrolBot sources config, refer to "patrolbot config --help"
discord:
  api: https://discord.com/api/v10
  token: "token"
userAgent: "PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)"
wiki: "zw"
wikis:
  zw:
    site:
      url: "https://zeldawiki.wiki"
      scriptPath: ""
      articlePath: ""
      rcLinkLimit: 1000
      rcMaxAgeDays: 90
    auth:
      username: "PhantomCaleb@Patrolbot"
      password: "password"
    client:
      from: "phantomcalebs@example.test"
      timeout: "10s"
    reports:
      templateDir: ./templates
      discordServerID: "server1234"
      types:
        weekly:
          template: weekly.tmpl
          discordChannelID: "channel1234"
          data:
            patrolExpiring:
              windows:
                - days: 7
                - days: 14
                - days: 30
-- output.golden --

