env HOME=$WORK/home

exec patrolbot config view --help
cmp stdout help.golden

exec patrolbot config view -h
cmp stdout help.golden

exec patrolbot config view
cmp stdout basic-home-config.golden

# Env variables can override config.yaml properties.
env PATROLBOT_DISCORD_TOKEN=token
env PATROLBOT_WIKIS_ZWEN_CLIENT_PASSWORD=password
exec patrolbot config view
cmp stdout override-env.golden
env PATROLBOT_WIKIS_ZWEN_CLIENT_PASSWORD=
env PATROLBOT_DISCORD_TOKEN=

# config.yaml in current directory has precedence over home config.
# Config files are not merged - only the highest precedence file is considered.
cp wikipedia.yaml config.yaml
exec patrolbot config view
cmp stdout override-curdir.golden
rm config.yaml

# config file specified via flag has precedence over ./config.yaml and $HOME/.patrolbot/config.yaml
cp wikipedia.yaml config.yaml
exec patrolbot config view --config dunepedia.yaml
cmp stdout override-config-flag.golden
rm config.yaml

# -c is a shorthand for --config
exec patrolbot config view -c dunepedia.yaml
cmp stdout override-config-flag.golden

-- help.golden --

  View JSON representation of the final configuration used by PatrolBot after resolving command-line flags, environment 
  variables, and config files.                                                                                          
         
  USAGE  
         
    patrolbot config view [--flags]  
         
  FLAGS  
         
    -c --config  Path to config file (default locations: ./config.yaml, $HOME/.patrolbot/config.yaml)
    -h --help    Help for view

-- home/.patrolbot/config.yaml --
discord:
  api: https://discord.com/api/v10
  appID: "1452202767694168094"
  publicKey: 62ba213b620e0fdd7ee296059267ef48b5ebec3e852915fb14f9f390609ffe72
  token: ""
server:
  port: 8080
  timeouts:
    readTimeout: 15s
    readHeaderTimeout: 5s
    writeTimeout: 15s
    idleTimeout: 60s
userAgent: PatrolBot/1.0 (+https://github.com/iocalebs/patrolbot)
wiki: zwen
wikis:
  zwen:
    site:
      url: https://zeldawiki.wiki
      scriptPath: /w
      articlePath: /wiki
      rcLinkLimit: 1000
      rcMaxAgeDays: 90
    auth:
      username: PhantomCaleb@Patrolbot
      password: ""
    client:
      from: phantomcaleb@zeldawiki.wiki
      timeout: 10s
    reports:
      templateDir: ./reports
      discordServerID: "911393793666863116"
      types:
        weekly:
          template: weekly.tmpl
          discordChannelID: "911393794262458421"
          data:
            patrolExpiring:
              windows:
                - days: 7
                - days: 14
                - days: 30

  zwfr:
    site:
      url: https://fr.zeldawiki.wiki
      scriptPath: /w
      articlePath: /wiki
      rcLinkLimit: 1000
      rcMaxAgeDays: 90
    auth:
      username: FantômeCaleb@Patrolbot
      password: ""
    client:
      from: phantomcaleb@zeldawiki.wiki
      timeout: "0"
    reports:
      templateDir: ./reports
      discordServerID: "911393793666863116"
      types:
        weekly:
          template: weekly.tmpl
          discordChannelID: "911393794262458421"
          data:
            patrolExpiring:
              windows:
                - days: 7
                - days: 14
                - days: 30

-- wikipedia.yaml --
wiki: wikipedia

-- dunepedia.yaml --
wiki: dunepedia

