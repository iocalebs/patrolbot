
[short] skip
# Scenario: Home config already exists, user declines overwrite
env HOME=$WORK/home
mkdir -p $HOME/.patrolbot
cp config.yaml $HOME/.patrolbot/config.yaml
mkdir -p $HOME/.patrolbot/templates
cp weekly.tmpl $HOME/.patrolbot/templates/weekly.tmpl

exec vhs cassette.tape
scrub output.ascii
cmp $HOME/.patrolbot/config.yaml config.yaml
cmp $HOME/.patrolbot/templates/weekly.tmpl weekly.tmpl
cmp output.ascii output.golden

-- config.yaml --
wiki: zwen

-- weekly.tmpl --
Pre-existing template

-- cassette.tape --
Output output.ascii
Set Width 3000 # prevents text wrapping, which prevents the scrub command from doing its text replacements

# Run command, decline overwrite by selecting default "no" option
Hide
Type "patrolbot init"
Enter
Sleep 200ms
Show
Enter

-- output.golden --

> patrolbot init
┃ Configuration already exists at $WORK/home/.patrolbot
┃
┃ Overwrite existing config?
┃
┃   Yes     No

←/→ toggle • enter submit • y Yes • n No










────────────────────────────────────────────────────────────────────────────────
> patrolbot init
>
















