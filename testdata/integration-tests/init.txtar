exec patrolbot init --help
cmp stdout help.golden

exec patrolbot init -h
cmp stdout help.golden

# $HOME env variable must be set
env HOME=
! exec patrolbot init
cmp stderr err-no-home.golden

# patrolbot must have permissions to stat files in home dir
mkdir $WORK/home
env HOME=$WORK/home
chmod 000 $HOME
# Prevents line wrapping so scrub command can work properly
env __FANG_TEST_WIDTH=300
! exec patrolbot init
scrub stderr
cmp stderr err-stat-home-config.golden
rm -r $HOME
env __FANG_TEST_WIDTH=

-- help.golden --

  Interactively create an initial configuration file at $HOME/.patrolbot/config.yaml.                                   
         
  USAGE  
         
    patrolbot init [--flags]  
         
  FLAGS  
         
    -h --help  Help for init

-- err-no-home.golden --
          
   ERROR  
          
  Failed to obtain user home directory: $HOME is not defined.                                                         

-- err-stat-home-config.golden --

   ERROR

  Error checking home config directory: stat $WORK/home/.patrolbot: permission denied.
